{
  "manifest_version": 3,
  "name": "TechPeek — Instant Tech Stack Detector",
  "description": "Lightweight Wappalyzer alternative. Instantly detect web frameworks, hosting, CMS, analytics, libraries, and UI tools on any website.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TechPeek",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
